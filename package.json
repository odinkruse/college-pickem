{
  "name": "college-pickem",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:push": "supabase db push --remote",
    "db:types": "supabase gen types --lang typescript --remote --schema public > src/lib/supabase/database.types.ts",
    "db:test": "supabase db query --remote --yes -f supabase/tests/pick_rules.sql",
    "typecheck": "next typegen && tsc --noEmit",
    "sync": "tsx --conditions=react-server scripts/sync.mts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
