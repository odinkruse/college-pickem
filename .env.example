# Copy to .env.local and fill in. .env.local is git-ignored.
# On Vercel, set the same variables under Project → Settings → Environment Variables.

# Supabase → Project Settings → API (Data API) → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase → Project Settings → API Keys.
# Publishable key (sb_publishable_…, or the legacy "anon" key). Safe in the browser; used once login exists.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…, or the legacy "service_role" key). Server only — bypasses Row Level Security.
SUPABASE_SECRET_KEY=

# https://collegefootballdata.com/key — if already exported in your shell, Next.js picks it up locally.
CFBD_API_KEY=

# Shared secret for the scheduler (Supabase pg_cron -> /api/cron). Also stored in Supabase Vault as pickem_cron_secret.
CRON_SECRET=
